<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus</title>
    <style>
        /* ===== PAGE BREAK STYLES ===== */
        .page-break {
            page-break-before: always;
            break-before: page;
        }
        
        .no-break {
            page-break-inside: avoid;
            break-inside: avoid;
        }
        
        /* Allow tall rows to break across pages */
        .allow-break {
            page-break-inside: auto;
            break-inside: auto;
        }
        
        .first-page-content {
            page-break-after: always;
            break-after: page;
        }

        /* ===== ORPHAN/WIDOW CONTROL ===== */
        tbody {
            orphans: 1;
            widows: 1;
        }

        thead {
            display: table-header-group;
        }

        /* ===== PRINT MEDIA ===== */
        @media print {
            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color-adjust: exact;
            }
            
            body {
                margin: 0;
                padding: 0;
            }
        }
    </style>
</head>
<body style="background-color: #fff; margin:0px; padding: 0px;">
    <table style="font-family: Arial, sans-serif; width: 1122px; margin: auto;">
        <tr>
            <td style="padding: 12px;">
                
                <!-- ===== PAGE 1: METADATA ONLY ===== -->
                <div class="first-page-content">
                    <table style="font-family: Arial, sans-serif; width: 100%; margin: auto;">
                        <tr>
                            <td rowspan="4" style="width: 60%;">
                                <h1 style="font-size:2rem; margin: 0px; padding: 0px;">
                                    <%= rundownName %>
                                </h1>
                            </td>
                            <td rowspan="4" style="width: 20%; text-align: center; padding: 0px;">
                                <% if (cueSheetValues.thumbnailURL) { %>
                                <img src="<%= cueSheetValues.thumbnailURL %>" alt="Thumbnail" style="width: 100px; height: auto;">
                                <% } %>
                            </td>
                            <td style="width: 20%; font-size: 20px;">
                                Episode Number: <label style="font-weight: 600;"><%= episodeNumber %></label>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%; font-size: 20px; white-space: nowrap;">
                                Generated On: <label style="font-weight: 600;"><%= timestamp %></label>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%; font-size: 20px;">
                                Total Rows: <label style="font-weight: 600;"><%= rowCount %></label>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%; font-size: 20px;">
                                Total Duration: <label style="font-weight: 600;"><%= totalDuration %></label>
                            </td>
                        </tr>
                    </table>
                    
                    <br/>
                    
                    <!-- CUE SHEET VALUES TABLE -->
                    <table style="border: 1px solid hsl(0, 0%, 73%); border-collapse: collapse; width: 100%; font-family: Arial, sans-serif; font-size: 20px;">
                        <% Object.entries(cueSheetValues).forEach(([key, value]) => { %>
                            <% if (key !== 'thumbnailURL') { %>
                            <tr>
                                <td style="padding: 10px; border: 1px solid hsl(0, 0%, 73%); width: 20%;">
                                    <%= key %>
                                </td>
                                <td style="padding: 10px; border: 1px solid hsl(0, 0%, 73%);">
                                    <%= value || '-' %>
                                </td>
                            </tr>
                            <% } %>
                        <% }) %>
                    </table>
                </div>

                <!-- ===== PAGE 2 & BEYOND: DATA ROWS ===== -->
                <div class="page-break">
                    <table style="width: 100%; padding: 0px; margin: 0px;">
                        <tr>
                            <td style="font-size:22px; color:hwb(16 0% 0%); padding:12px 0; font-weight:600;">
                                <span>Episode Number:</span> <span><%= episodeNumber %></span>
                                <span style="margin:0 8px;">|</span>
                                <span>Air Date:</span> <span><%= cueSheetValues['Air Date'] %></span>
                            </td>
                        </tr>
                    </table>

                    <!-- DATA TABLE -->
                    <table style="border-collapse: collapse; table-layout: fixed; font-family: Arial, sans-serif; font-size: 20px; width: 100%;">
                        <% 
                            const hasAnyLock = rows.some(row => row.isLocked);
                            const hasAnyIcon = rows.some(row => row.rowIcon?.src);
                        %>
                        
                        <!-- TABLE HEADER -->
                        <thead>
                            <tr style="background-color: hsl(213, 20%, 89%)">
                                <th style="border: 1px solid hsl(0, 0%, 73%); padding: 5px; text-align: left; width: 40px;">#</th>
                                
                                <!-- Lock Column -->
                                <% if (hasAnyLock) { %>
                                <th style="border: 1px solid hsl(0, 0%, 73%); padding: 5px; text-align: center; width: 25px;">
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                                        <path d="M2 16C2 13.1716 2 11.7574 2.87868 10.8787C3.75736 10 5.17157 10 8 10H16C18.8284 10 20.2426 10 21.1213 10.8787C22 11.7574 22 13.1716 22 16C22 18.8284 22 20.2426 21.1213 21.1213C20.2426 22 18.8284 22 16 22H8C5.17157 22 3.75736 22 2.87868 21.1213C2 20.2426 2 18.8284 2 16Z" stroke="black" stroke-width="2"/>
                                        <circle cx="12" cy="16" r="2" stroke="black" stroke-width="2"/>
                                        <path d="M6 10V8C6 4.68629 8.68629 2 12 2C15.3137 2 18 4.68629 18 8V10" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
                                    </svg>
                                </th>
                                <% } %>
                                
                                <!-- Icon Column -->
                                <% if (hasAnyIcon) { %>
                                <th style="border: 1px solid hsl(0, 0%, 73%); padding: 5px; text-align: center; width: 35px;">
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                        <path d="M4 3v18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                                        <path d="M4 5c2 0 3.2 0.9 5 0.9s3-0.9 5-0.9 3.2 0.9 5 0.9v6 c-2 0-3.2-0.9-5-0.9s-3 0.9-5 0.9S6 11 4 11V5z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </th>
                                <% } %>

                                <!-- Data Columns -->
                                <% columns.forEach(column => { %>
                                <th style="border: 1px solid hsl(0, 0%, 73%); padding: 5px; text-align: left; width: <%= column.width %>;">
                                    <%= column.displayName %>
                                </th>
                                <% }) %>
                            </tr>
                        </thead>

                        <!-- TABLE BODY -->
                        <tbody>
                            <% rows.forEach((row, posIndex) => {
                                const rowColor = Array.isArray(row.rowColor) ? `rgb(${row.rowColor.join(',')})` : null;
                                const rowStyle = rowColor ? `style="background-color: ${rowColor}"` : '';
                                
                                // ===== SMART ROW BREAKING LOGIC =====
                                // For first row: check if it's tall
                                const isFirstDataRow = posIndex === 0;
                                const rowHeightInfo = rowHeights && rowHeights[posIndex];
                                const isTallFirstRow = isFirstDataRow && rowHeightInfo?.isTall;
                                
                                // If first row is tall, allow breaking; otherwise keep it together
                                const rowBreakClass = isTallFirstRow ? "allow-break" : "no-break";
                            %>
                            
                            <!-- DATA ROW -->
                            <tr <%- rowStyle %> class="<%= rowBreakClass %>">
                                <td style="border: 1px solid hsl(0, 0%, 73%); padding: 5px;">
                                    <%= row.index %>
                                </td>
                                
                                <!-- Lock Cell -->
                                <% if (hasAnyLock) { %>
                                <td style="border: 1px solid hsl(0, 0%, 73%); padding: 5px;">
                                    <% if (row.isLocked) { %>
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block; vertical-align:middle;">
                                        <g id="Interface / Lock">
                                            <path id="Vector" d="M9.23047 9H7.2002C6.08009 9 5.51962 9 5.0918 9.21799C4.71547 9.40973 4.40973 9.71547 4.21799 10.0918C4 10.5196 4 11.0801 4 12.2002V17.8002C4 18.9203 4 19.4801 4.21799 19.9079C4.40973 20.2842 4.71547 20.5905 5.0918 20.7822C5.5192 21 6.07902 21 7.19694 21H16.8031C17.921 21 18.48 21 18.9074 20.7822C19.2837 20.5905 19.5905 20.2842 19.7822 19.9079C20 19.4805 20 18.9215 20 17.8036V12.1969C20 11.079 20 10.5192 19.7822 10.0918C19.5905 9.71547 19.2837 9.40973 18.9074 9.21799C18.4796 9 17.9203 9 16.8002 9H14.7689M9.23047 9H14.7689M9.23047 9C9.10302 9 9 8.89668 9 8.76923V6C9 4.34315 10.3431 3 12 3C13.6569 3 15 4.34315 15 6V8.76923C15 8.89668 14.8964 9 14.7689 9" stroke="#e80909" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </g>
                                    </svg>
                                    <% } %>
                                </td>
                                <% } %>

                                <!-- Icon Cell -->
                                <% if (hasAnyIcon) { %>
                                <td style="border: 1px solid hsl(0, 0%, 73%); padding: 5px;">
                                    <% if (row.rowIcon?.src) { %>
                                    <img src="<%= ICONS_DIR + row.rowIcon.src %>" style="width:28px;">
                                    <% } %>
                                </td>
                                <% } %>

                                <!-- Data Cells -->
                                <% columns.forEach(column => { %>
                                <td style="border: 1px solid hsl(0, 0%, 73%); padding: 5px; word-wrap: break-word; overflow-wrap: break-word; width: <%= column.width %>;">
                                    <% if (column.columnName === 'vidId') { %>
                                    <a href="<%= row[column.columnName] %>" target="_blank" rel="noopener noreferrer" style="display: block; word-wrap: break-word; overflow-wrap: break-word; max-width: 100%; white-space: normal; font-size: 20px;">
                                        <%= row[column.columnName] %>
                                    </a>
                                    <% } else { %>
                                    <%- row[column.columnName] %>
                                    <% } %>
                                </td>
                                <% }) %>
                            </tr>

                            <!-- NOTES ROWS (stay with parent row) -->
                            <% if (
                                selectedNotes[row.rowId] &&
                                Array.isArray(row.rowNotes) &&
                                row.rowNotes.some(note => (note.title || note.notes))
                            ) {
                                row.rowNotes.forEach(note => {
                                    if (note.title || note.notes) { %>
                            <tr class="no-break">
                                <td colspan="<%= columns.length + (hasAnyLock ? 1 : 0) + (hasAnyIcon ? 1 : 0) + 1 %>" style="border: 1px solid hsl(0, 0%, 73%); padding: 5px;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="text-align: left;">
                                                <% if (note.title) { %>
                                                <h4 style="margin: 0px; padding: 0px;">
                                                    <%= note.title %>
                                                </h4>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="text-align: left;">
                                                <%- note.notes %>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                                    <% } %>
                                <% }) %>
                            <% } %>

                            <% }) %>
                        </tbody>
                    </table>
                </div>

            </td>
        </tr>
    </table>
</body>
</html>